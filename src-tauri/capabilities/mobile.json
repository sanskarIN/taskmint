{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "taskmint-mobile",
  "description": "Least-privilege native capabilities for the TaskMint Android and iOS window.",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-stat",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "notification:default",
    "opener:default"
  ]
}
